# ==========================================
# Lab 2 — Qdrant Production RAG Environment
# ==========================================

# ------------------------------------------
# EDGE AUTHENTICATION (REQUIRED)
# ------------------------------------------
EDGE_API_KEY=replace-with-long-random-value

# ------------------------------------------
# OLLAMA SETTINGS
# ------------------------------------------
OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://ollama:11434

# ------------------------------------------
# QDRANT SETTINGS
# ------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=LabDoc

# ------------------------------------------
# EMBEDDINGS SERVICE (TEI) — for LabDoc
# ------------------------------------------
EMBEDDINGS_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBEDDINGS_DIM=384

# ------------------------------------------
# RAG TUNING SETTINGS (LabDoc retrieval)
# ------------------------------------------
RAG_TOP_K=5
RAG_MAX_SOURCE_CHARS=1200

# ------------------------------------------
# GRADIO
# ------------------------------------------
GRADIO_HTTP_TIMEOUT_S=600

# ------------------------------------------
# SECURITY MEMORY SETTINGS (separate collection)
# ------------------------------------------
SECURITY_COLLECTION=ExpandedVSCodeMemory
SECURITY_TOP_K=6
SECURITY_CHUNK_CHARS=1200
SECURITY_CHUNK_OVERLAP=200

# Security memory embeddings (Ollama)
SECURITY_EMBED_MODEL=nomic-embed-text
SECURITY_EMBED_DIM=768
